# App
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=lanterned_session
SESSION_TTL_HOURS=72
# "lax" if frontend+API share a registrable domain; "none" if they're on unrelated domains
# (e.g. a Netlify/Vercel URL calling a Render URL) — "none" requires HTTPS on both.
SESSION_COOKIE_SAMESITE=lax

# Teacher accounts are privileged. Registering as a teacher requires this invite code.
# Leave blank in development to allow open teacher sign-up; in production blank = closed.
TEACHER_INVITE_CODE=

# Comma-separated emails that may never self-register (student or teacher). A baseline
# (the institution's own admin/EmailJS account email) is always blocked regardless of this.
BLOCKED_REGISTRATION_EMAILS_EXTRA=

# Admin panel (/admin). Set BOTH to enable admin sign-in; leave blank to keep it disabled.
# Server-side only: never put these in the frontend or commit real values. The password is stored hashed (argon2).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set to true for ONE restart to change the admin password to the value above, then set it back to false.
ADMIN_RESET_PASSWORD_ON_START=false
ADMIN_SESSION_TTL_MINUTES=120

# Max upload size per file, in MB.
MAX_UPLOAD_MB=500

# Database
# Local dev default (no setup required): sqlite:///./dev.db
# Production / Neon: postgresql+psycopg2://user:password@ep-name.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# LiveKit (leave blank to disable classroom endpoints gracefully)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Point the LiveKit server's webhook at POST {API_BASE}/api/v1/webhooks/livekit (signed with the key above).

# Recording policy: recording is always an explicit teacher action and stays private until published.
# RECORDING_ENABLED=false is the institution-wide kill switch.
RECORDING_ENABLED=true
SIGNED_URL_TTL_SECONDS=300

# Object storage: "local" writes to backend/media (default, zero setup)
# or "s3" for an S3-compatible bucket (AWS S3 / MinIO / R2)
STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=lanterned-storage
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto


# AI providers (leave blank to use the clearly-labeled stub provider)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Only set this if LLM_API_KEY is from an OpenAI-compatible third-party/proxy provider
# rather than real OpenAI (leave blank for real OpenAI).
LLM_BASE_URL=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=whisper-1
# Only set this if the STT key is from an OpenAI-compatible third-party provider rather than real
# OpenAI — e.g. Groq also hosts Whisper for free: SPEECH_TO_TEXT_BASE_URL=https://api.groq.com/openai/v1,
# SPEECH_TO_TEXT_MODEL=whisper-large-v3-turbo (leave blank for real OpenAI).
SPEECH_TO_TEXT_BASE_URL=

# Password-reset OTP emails via EmailJS's server-side REST API (api.emailjs.com) — called
# directly from the backend, never the browser SDK, so the OTP and its recipient stay
# server-controlled. Leave blank in development: the OTP is returned in the API response
# instead of emailed. EMAILJS_PRIVATE_KEY is the dashboard's "Private Key" (Account -> Security)
# — required once an account has "block non-browser requests" on; never put it in frontend code.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
# Optional: a second template for the concurrent-login-approval OTP, worded for "someone is
# signing in to your account from a new device" instead of a password reset. Falls back to
# EMAILJS_TEMPLATE_ID if left unset.
EMAILJS_LOGIN_TEMPLATE_ID=
# Optional: a third template ("Verify Your LanternEd Email Address") for the registration
# email-verification OTP, sent before any account exists. Falls back to EMAILJS_TEMPLATE_ID.
EMAILJS_REGISTRATION_TEMPLATE_ID=
# Optional: EmailJS's free tier caps templates per account, so registration may need its own
# SEPARATE EmailJS account entirely (different service, public key and private key — a template
# always belongs to one account). Set all three together to use it; leave all blank to use the
# shared account above instead.
EMAILJS_REGISTRATION_SERVICE_ID=
EMAILJS_REGISTRATION_PUBLIC_KEY=
EMAILJS_REGISTRATION_PRIVATE_KEY=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Minutes an OTP is valid for (default 5) / attempts allowed per OTP (default 5) / seconds before
# a new OTP may be requested (default 60) / minutes the post-OTP reset/registration authorization
# is valid for (default 10). All have sane defaults; only set these to override them.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
RESET_TOKEN_TTL_MINUTES=10
# Registration requires proving control of the email address first (OTP emailed before the
# account is created). True by default; set to false only for local development without
# EmailJS configured and you're fine skipping real verification.
REQUIRE_REGISTRATION_OTP=true

# Long-recording transcription (FFmpeg must be installed; the Docker image includes it)
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=1800
STT_MAX_UPLOAD_BYTES=25165824
STT_CHUNK_SECONDS=600

# Cloudflare R2 / S3-compatible storage: OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
# OBJECT_STORAGE_REGION=auto. Set OBJECT_STORAGE_FORCE_PATH_STYLE=true for emulators/self-hosted stores.
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Offline submissions made before a deadline may sync up to this many hours after it
OFFLINE_SUBMISSION_GRACE_HOURS=24

# Error tracking (Sentry or a compatible service). Leave empty to disable. No request bodies, cookies or user
# details are sent. Alert on new issues and on a spike in 5xx.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Behind a reverse proxy, tell uvicorn which addresses may set X-Forwarded-For so per-IP rate limits see the real
# client (otherwise every user shares the proxy's address). Examples: the private ranges when Caddy is the only
# ingress, or * when the platform's edge is the only way in.
FORWARDED_ALLOW_IPS=

# ==============================================================================
# Transactional Email & OTPs (Resend is the recommended primary provider)
# ==============================================================================
# Set both RESEND_API_KEY and EMAIL_FROM to use Resend for password resets,
# second-device approvals, and student/teacher registration email verifications.
# When both are set, Resend automatically takes full precedence over EmailJS.
# EMAIL_FROM: Use your verified Resend domain, or "LanternEd <onboarding@resend.dev>" for testing.
RESEND_API_KEY=
EMAIL_FROM=

# Data retention (the worker enforces these). Recording media older than this many days is deleted; leave empty to keep
# recordings until a teacher deletes them. Notifications older than NOTIFICATION_RETENTION_DAYS are pruned.
RECORDING_RETENTION_DAYS=
NOTIFICATION_RETENTION_DAYS=90

# Razorpay online payments (optional; manual payment recording works without it). Point a Razorpay webhook at
# POST /api/v1/webhooks/razorpay for payment.captured and order.paid, and put its secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp notifications (optional; only people who add their number and tick the consent box are messaged).
# Create the approved template described in docs/launch/WHATSAPP.md first.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=lanterned_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# ElevenLabs Text-to-Speech Voice Summary
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Render Workflows
RENDER_API_KEY=
